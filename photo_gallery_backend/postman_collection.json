                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.message).to.eql('Admin access required');",
                  "});",
                  "",
                  "console.log(' Security test: Normal user denied admin access');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        }
      ]
    }
  ]
